# /etc/avimax/backend.env — variables de entorno para el servicio systemd
# Copiar a /etc/avimax/backend.env y ajustar valores antes de iniciar el servicio

SPRING_PROFILES_ACTIVE=raspberry-prod

# Base de datos local
DB_URL=jdbc:postgresql://localhost:5432/avimax
DB_USERNAME=avimax
DB_PASSWORD=cambia_esto

# MQTT broker local (Mosquitto en la misma Raspberry)
MQTT_BROKER_URL=tcp://127.0.0.1:1883
MQTT_CLIENT_ID=avimax-raspi-galpon-01
MQTT_USERNAME=
MQTT_PASSWORD=

# Identificadores de galpón y gateway
APP_GALPON_ID=1
APP_GATEWAY_ID=raspi5-galpon-01
