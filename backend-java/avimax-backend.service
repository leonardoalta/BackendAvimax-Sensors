[Unit]
Description=AviMax Local Backend (Raspberry Pi)
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=avimax
Group=avimax
WorkingDirectory=/opt/avimax

# Cargar variables de entorno desde /etc/avimax/backend.env
EnvironmentFile=/etc/avimax/backend.env

ExecStart=/usr/bin/java \
  -Xms128m -Xmx256m \
  -Dspring.profiles.active=${SPRING_PROFILES_ACTIVE:-raspberry-prod} \
  -jar /opt/avimax/avimax-backend.jar

# Reinicio automático si el proceso muere
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5

# Logs al journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=avimax-backend

# Seguridad básica
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/avimax/logs

[Install]
WantedBy=multi-user.target
